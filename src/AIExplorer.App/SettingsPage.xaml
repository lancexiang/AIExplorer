<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="AIExplorer_App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:AIExplorer_App.ViewModels">

    <Grid Padding="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="设置" Style="{StaticResource TitleTextBlockStyle}" />
            <Button Grid.Column="1" Content="返回" Click="OnBackClick" />
        </Grid>

        <ScrollViewer Grid.Row="1">
            <StackPanel Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                <TextBlock Text="性能" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch
                    Header="性能模式（关闭缩略图 / Probe / 文件夹递归大小）"
                    IsOn="{x:Bind ViewModel.PerformanceMode, Mode=TwoWay}" />
                <ToggleSwitch
                    Header="列表缩略图"
                    IsOn="{x:Bind ViewModel.EnableListThumbnails, Mode=TwoWay}" />
                <ToggleSwitch
                    Header="图像 Probe 列（TIFF 头等，默认关）"
                    IsOn="{x:Bind ViewModel.EnableImageProbeColumns, Mode=TwoWay}" />
                <ToggleSwitch
                    Header="自动计算本地文件夹大小（网络盘仍仅右键手动；可能较慢）"
                    OffContent="关闭（推荐）"
                    OnContent="开启本地盘自动计算"
                    IsOn="{x:Bind ViewModel.EnableFolderRecursiveSize, Mode=TwoWay}" />

                <TextBlock Margin="0,12,0,0" Text="文件与路径" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch
                    Header="复制映射网络盘路径时使用完整 UNC 地址"
                    OffContent="保留盘符（如 J:\）"
                    OnContent="使用完整地址（如 \\server\share）"
                    IsOn="{x:Bind ViewModel.CopyMappedDriveAsUnc, Mode=TwoWay}" />

                <TextBlock Margin="0,12,0,0" Text="侧栏导航" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ToggleSwitch
                    Header="目录树跟随当前路径（展开并滚动定位）"
                    OffContent="关闭：不自动展开"
                    OnContent="开启：自动展开定位"
                    IsOn="{x:Bind ViewModel.AutoRevealInTree, Mode=TwoWay}" />
                <TextBlock
                    Opacity="0.65"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Text="「收起」是一次性动作，收起后仍可手动展开盘符。需要露出盘符时再点一次即可。" />

                <TextBlock Margin="0,12,0,0" Text="文件颜色标记" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock
                    Opacity="0.65"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Text="显示名与含义可改；Key 不变，已标记文件不会丢。悬停列表色点可见含义。" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.FileColors, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileColorEditItem">
                            <Grid Margin="0,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="56" />
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Opacity="0.7"
                                    Text="{x:Bind Key}" />
                                <TextBox
                                    Grid.Column="1"
                                    Header="显示名"
                                    Text="{x:Bind DisplayName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Grid.Column="2"
                                    Header="色值"
                                    Text="{x:Bind Hex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBox
                                    Grid.Column="3"
                                    Header="含义备注"
                                    Text="{x:Bind Description, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Margin="0,12,0,0" Text="外观" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ComboBox
                    Header="主题（跟随系统 / 浅色 / 深色）"
                    Width="220"
                    ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                    SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}" />
                <ComboBox
                    Margin="0,8,0,0"
                    Header="强调色"
                    Width="220"
                    ItemsSource="{x:Bind ViewModel.AccentOptions}"
                    SelectedItem="{x:Bind ViewModel.AccentColor, Mode=TwoWay}" />
                <ComboBox
                    Margin="0,8,0,0"
                    Header="窗口背景"
                    Width="220"
                    ItemsSource="{x:Bind ViewModel.BackdropOptions}"
                    SelectedItem="{x:Bind ViewModel.WindowBackdrop, Mode=TwoWay}" />
                <TextBlock
                    Margin="0,4,0,0"
                    Opacity="0.65"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Text="保存后立即生效。强调色：Ocean/Forest/Sunset/Violet；背景：Mica/Acrylic/None。" />

                <TextBlock Margin="0,12,0,0" Text="扩展" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.Extensions, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExtensionToggleItem">
                            <ToggleSwitch
                                Margin="0,4"
                                Header="{x:Bind DisplayName}"
                                IsOn="{x:Bind Enabled, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock
                    Margin="0,12,0,0"
                    Opacity="0.7"
                    TextWrapping="Wrap"
                    Text="已具备：锁定标签固定路径、颜色标记（左条+右点）、可配置颜色含义。后续：Git / Agent 等。" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="保存" Click="OnSaveClick" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
