<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AIExplorer_App.Views.FilePaneControl"
    x:Name="Root"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:AIExplorer_App.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <Grid
        HorizontalAlignment="Stretch"
        VerticalAlignment="Stretch"
        Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 统一地址栏 -->
        <Grid
            Grid.Row="0"
            Padding="8,5"
            ColumnSpacing="2"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button
                Grid.Column="0"
                Style="{StaticResource AppToolButtonStyle}"
                Command="{Binding GoBackCommand}"
                IsEnabled="{Binding CanGoBack}"
                ToolTipService.ToolTip="后退">
                <FontIcon Glyph="&#xE72B;" FontSize="13" />
            </Button>
            <Button
                Grid.Column="1"
                Style="{StaticResource AppToolButtonStyle}"
                Command="{Binding GoForwardCommand}"
                IsEnabled="{Binding CanGoForward}"
                ToolTipService.ToolTip="前进">
                <FontIcon Glyph="&#xE72A;" FontSize="13" />
            </Button>
            <Button
                Grid.Column="2"
                Style="{StaticResource AppToolButtonStyle}"
                Command="{Binding GoUpCommand}"
                ToolTipService.ToolTip="上级目录">
                <FontIcon Glyph="&#xE74B;" FontSize="13" />
            </Button>

            <Border
                x:Name="BreadcrumbHost"
                Grid.Column="3"
                MinHeight="28"
                Margin="4,0"
                Padding="4,0,2,0"
                CornerRadius="6"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                Tapped="OnAddressBarTapped"
                DoubleTapped="OnAddressDoubleTapped"
                Visibility="{Binding IsEditingPath, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}">
                <Border.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem
                            Text="复制完整路径"
                            Click="OnCopyAddressPathClick" />
                    </MenuFlyout>
                </Border.ContextFlyout>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer
                        Grid.Column="0"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollMode="Disabled"
                        VerticalAlignment="Center"
                        Background="Transparent">
                        <ItemsControl ItemsSource="{Binding Breadcrumb}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PathSegmentViewModel">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Opacity="{x:Bind SegmentOpacity}">
                                        <Button
                                            Padding="6,2"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            FontSize="12"
                                            Click="OnBreadcrumbClick"
                                            Tag="{x:Bind FullPath}"
                                            Content="{x:Bind Label}" />
                                        <FontIcon Glyph="&#xE76C;" FontSize="9" Margin="0,0,2,0" Opacity="0.45" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- 路径条最右侧刷新，对齐资源管理器习惯位置 -->
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource AppToolButtonStyle}"
                        VerticalAlignment="Center"
                        Command="{Binding RefreshCommand}"
                        ToolTipService.Placement="Top"
                        ToolTipService.ToolTip="刷新 (F5)">
                        <FontIcon Glyph="&#xE72C;" FontSize="12" />
                    </Button>
                </Grid>
            </Border>

            <TextBox
                x:Name="AddressBox"
                Grid.Column="3"
                Margin="4,0"
                MinHeight="28"
                PlaceholderText="输入路径后回车"
                Text="{Binding EditablePath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                KeyDown="OnAddressKeyDown"
                LostFocus="OnAddressLostFocus"
                Visibility="{Binding IsEditingPath, Converter={StaticResource BoolToVisibilityConverter}}" />
        </Grid>

        <Grid Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 顶部工具行：筛选框 + 显眼的状态信息 + 列配置 -->
            <Grid Grid.Row="0" Margin="8,6,8,4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox
                    Grid.Column="0"
                    MinHeight="28"
                    PlaceholderText="筛选当前目录"
                    FontSize="12"
                    Text="{Binding FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Border
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Padding="10,3"
                    CornerRadius="6"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource AppAccentBrush}"
                        Text="{Binding StatusText, Mode=OneWay}" />
                </Border>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                    <Button
                        Style="{StaticResource AppToolButtonStyle}"
                        MinHeight="28"
                        MinWidth="32"
                        Command="{Binding SetDetailsViewCommand}"
                        ToolTipService.ToolTip="详细信息">
                        <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                    </Button>
                    <Button
                        Style="{StaticResource AppToolButtonStyle}"
                        MinHeight="28"
                        MinWidth="32"
                        Command="{Binding SetIconsViewCommand}"
                        ToolTipService.ToolTip="图标">
                        <FontIcon Glyph="&#xE8B9;" FontSize="14" />
                    </Button>
                    <Button
                        Style="{StaticResource AppToolButtonStyle}"
                        MinHeight="28"
                        MinWidth="32"
                        Command="{Binding SetCardsViewCommand}"
                        ToolTipService.ToolTip="卡片">
                        <FontIcon Glyph="&#xE8A1;" FontSize="14" />
                    </Button>
                </StackPanel>

                <Button
                    Grid.Column="3"
                    Style="{StaticResource AppToolButtonStyle}"
                    MinHeight="28"
                    MinWidth="32"
                    VerticalAlignment="Center"
                    Command="{Binding TogglePreviewPaneCommand}"
                    ToolTipService.ToolTip="预览窗格">
                    <FontIcon Glyph="&#xE7B3;" FontSize="14" />
                </Button>

                <Button
                    Grid.Column="4"
                    Style="{StaticResource AppToolButtonStyle}"
                    MinHeight="28"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="配置显示的列"
                    Visibility="{Binding IsDetailsView, Converter={StaticResource BoolToVisibilityConverter}}">
                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <ToggleMenuFlyoutItem Text="大小" IsChecked="{Binding Columns.ShowSize, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="类型" IsChecked="{Binding Columns.ShowType, Mode=TwoWay}" />
                            <ToggleMenuFlyoutItem Text="修改时间" IsChecked="{Binding Columns.ShowModified, Mode=TwoWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <!-- 列表头：可点击排序 + 列右缘拖动调宽（列结构与行模板一致） -->
            <Grid
                x:Name="DetailsHeader"
                Grid.Row="1"
                Padding="8,3,12,3"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Visibility="{Binding IsDetailsView, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4" />
                    <ColumnDefinition Width="36" />
                    <ColumnDefinition Width="*" MinWidth="120" />
                    <ColumnDefinition x:Name="HeaderSizeCol" Width="90" />
                    <ColumnDefinition x:Name="HeaderTypeCol" Width="70" />
                    <ColumnDefinition x:Name="HeaderModifiedCol" Width="200" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Name="NameHeaderButton"
                    Grid.Column="2"
                    Padding="0,0,8,0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Click="OnSortByNameClick">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="名称" Opacity="0.55" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NameSortGlyph, Mode=OneWay}" Opacity="0.75" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
                <!-- 分割线在两列交界：拖动时左列 +dx、右列 -dx（名称列为 *，只调右侧固定列） -->
                <Border
                    Grid.Column="2"
                    Width="9"
                    Margin="0,0,-4,0"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    PointerEntered="OnSplitterPointerEntered"
                    PointerExited="OnSplitterPointerExited"
                    PointerPressed="OnSplitterPressed"
                    PointerMoved="OnColumnSplitterMoved"
                    PointerReleased="OnColumnSplitterReleased"
                    PointerCaptureLost="OnColumnSplitterCaptureLost"
                    Tag="name-size"
                    ToolTipService.ToolTip="拖动调整名称 / 大小列宽">
                    <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                               Margin="0,2" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                </Border>
                <Grid Grid.Column="3" Visibility="{Binding Columns.SizeVisibility, Mode=OneWay}">
                    <Button
                        Padding="0,0,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="OnSortBySizeClick">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="大小" Opacity="0.55" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SizeSortGlyph, Mode=OneWay}" Opacity="0.75" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Border
                        Width="9"
                        Margin="0,0,-4,0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        PointerEntered="OnSplitterPointerEntered"
                        PointerExited="OnSplitterPointerExited"
                        PointerPressed="OnSplitterPressed"
                        PointerMoved="OnColumnSplitterMoved"
                        PointerReleased="OnColumnSplitterReleased"
                        PointerCaptureLost="OnColumnSplitterCaptureLost"
                        Tag="size-type"
                        ToolTipService.ToolTip="拖动调整大小 / 类型列宽">
                        <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                   Margin="0,2" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </Border>
                </Grid>
                <Grid Grid.Column="4" Visibility="{Binding Columns.TypeVisibility, Mode=OneWay}">
                    <Button
                        Padding="0,0,8,0"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Left"
                        Click="OnSortByTypeClick">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <TextBlock Text="类型" Opacity="0.55" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding TypeSortGlyph, Mode=OneWay}" Opacity="0.75" FontSize="11" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>
                    <Border
                        Width="9"
                        Margin="0,0,-4,0"
                        HorizontalAlignment="Right"
                        Background="Transparent"
                        PointerEntered="OnSplitterPointerEntered"
                        PointerExited="OnSplitterPointerExited"
                        PointerPressed="OnSplitterPressed"
                        PointerMoved="OnColumnSplitterMoved"
                        PointerReleased="OnColumnSplitterReleased"
                        PointerCaptureLost="OnColumnSplitterCaptureLost"
                        Tag="type-modified"
                        ToolTipService.ToolTip="拖动调整类型 / 修改时间列宽">
                        <Rectangle Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                   Margin="0,2" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                    </Border>
                </Grid>
                <Button
                    Grid.Column="5"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Visibility="{Binding Columns.ModifiedVisibility, Mode=OneWay}"
                    Click="OnSortByModifiedClick">
                    <StackPanel Orientation="Horizontal" Spacing="2">
                        <TextBlock Text="修改时间" Opacity="0.55" FontSize="11" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ModifiedSortGlyph, Mode=OneWay}" Opacity="0.75" FontSize="11" FontWeight="SemiBold" />
                    </StackPanel>
                </Button>
            </Grid>

            <Grid Grid.Row="2" ColumnSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

            <Grid x:Name="ItemsHost" Grid.Column="0">
            <ListView
                x:Name="FileList"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsItemClickEnabled="False"
                CanDragItems="True"
                AllowDrop="True"
                DoubleTapped="OnListDoubleTapped"
                SelectionChanged="OnSelectionChanged"
                ContainerContentChanging="OnFileContainerContentChanging"
                KeyDown="OnListKeyDown"
                RightTapped="OnListRightTapped"
                DragItemsStarting="OnDragItemsStarting"
                DragItemsCompleted="OnDragItemsCompleted"
                DragOver="OnListDragOver"
                Drop="OnListDrop"
                ItemsSource="{Binding VisibleItems, Mode=OneWay}"
                SelectedItem="{Binding SelectedItem, Mode=OneWay}"
                SelectionMode="Extended"
                Visibility="{Binding IsDetailsView, Converter={StaticResource BoolToVisibilityConverter}}">
                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ItemsStackPanel CacheLength="2" />
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>
                <ListView.ItemContainerTransitions>
                    <TransitionCollection />
                </ListView.ItemContainerTransitions>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Padding" Value="2,0" />
                        <Setter Property="MinHeight" Value="{StaticResource AppListRowMinHeight}" />
                        <Setter Property="Margin" Value="0" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileListItemViewModel">
                        <Grid
                            Padding="6,2"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind TypeText}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="*" MinWidth="120" />
                                <ColumnDefinition Width="{x:Bind Columns.SizeWidth, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Columns.TypeWidth, Mode=OneWay}" />
                                <ColumnDefinition Width="{x:Bind Columns.ModifiedWidth, Mode=OneWay}" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="3"
                                CornerRadius="1.5"
                                VerticalAlignment="Stretch"
                                Margin="0,3"
                                Background="{x:Bind ColorKey, Mode=OneWay, Converter={StaticResource ColorKeyToBrushConverter}}"
                                ToolTipService.ToolTip="{x:Bind ColorTooltip, Mode=OneWay, Converter={StaticResource NullIfEmptyStringConverter}}" />
                            <!-- 层级缩进：子项相对父项右移，同层对齐 -->
                            <Border
                                Grid.Column="1"
                                Width="{x:Bind IndentWidth, Mode=OneWay}"
                                Background="Transparent" />
                            <!-- 展开按钮仅切换展开；拦截双击，避免误进目录 -->
                            <Button
                                x:Name="ExpandFolderButton"
                                Grid.Column="2"
                                Width="16"
                                Height="16"
                                MinWidth="16"
                                MinHeight="16"
                                Padding="0"
                                Margin="0,0,2,0"
                                Tag="ExpandFolder"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                IsTabStop="False"
                                AllowFocusOnInteraction="False"
                                Visibility="{x:Bind ExpandButtonVisibility, Mode=OneWay}"
                                Click="OnExpandFolderClick"
                                Tapped="OnExpandButtonTapped"
                                DoubleTapped="OnExpandButtonDoubleTapped"
                                PointerPressed="OnExpandButtonPointerPressed"
                                ToolTipService.ToolTip="展开/折叠子项">
                                <FontIcon
                                    Glyph="{x:Bind ExpandGlyph, Mode=OneWay}"
                                    FontSize="9"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                            </Button>
                            <Grid Grid.Column="3" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0">
                                <FontIcon
                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                    Glyph="{x:Bind IconGlyph}"
                                    FontSize="14"
                                    Foreground="{x:Bind GlyphBrush}"
                                    Visibility="{x:Bind HasBitmapIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                <Image
                                    Source="{x:Bind IconImage, Mode=OneWay}"
                                    Width="16"
                                    Height="16"
                                    Stretch="Uniform"
                                    Visibility="{x:Bind HasBitmapIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                            </Grid>
                            <StackPanel Grid.Column="4" VerticalAlignment="Center" Spacing="0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon
                                        Grid.Column="0"
                                        Glyph="&#xE840;"
                                        FontSize="11"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                        Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTipService.ToolTip="已置顶" />
                                    <TextBlock
                                        x:Name="ItemNameText"
                                        Grid.Column="1"
                                        Tag="ItemName"
                                        Text="{x:Bind Name, Mode=OneWay}"
                                        FontSize="13"
                                        HorizontalAlignment="Left"
                                        MaxWidth="{x:Bind Columns.NameTextMaxWidth, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTipService.ToolTip="{x:Bind Name, Mode=OneWay}" />
                                    <Ellipse
                                        Grid.Column="2"
                                        Width="8"
                                        Height="8"
                                        Margin="8,0,4,0"
                                        VerticalAlignment="Center"
                                        Fill="{x:Bind ColorKey, Mode=OneWay, Converter={StaticResource ColorKeyToBrushConverter}}"
                                        Visibility="{x:Bind HasColor, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTipService.ToolTip="{x:Bind ColorTooltip, Mode=OneWay, Converter={StaticResource NullIfEmptyStringConverter}}" />
                                </Grid>
                                <TextBlock
                                    FontSize="10"
                                    Opacity="0.55"
                                    Text="{x:Bind NoteDisplay, Mode=OneWay}"
                                    Visibility="{x:Bind HasNote, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock
                                Grid.Column="5"
                                VerticalAlignment="Center"
                                Opacity="0.65"
                                FontSize="12"
                                Visibility="{x:Bind Columns.SizeVisibility, Mode=OneWay}"
                                Text="{x:Bind SizeText, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="6"
                                VerticalAlignment="Center"
                                Opacity="0.65"
                                FontSize="12"
                                Visibility="{x:Bind Columns.TypeVisibility, Mode=OneWay}"
                                Text="{x:Bind TypeText}" />
                            <StackPanel
                                Grid.Column="7"
                                Orientation="Horizontal"
                                Spacing="8"
                                VerticalAlignment="Center"
                                Visibility="{x:Bind Columns.ModifiedVisibility, Mode=OneWay}">
                                <Border
                                    Background="{x:Bind AgeBrush}"
                                    CornerRadius="3"
                                    Padding="5,1"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        Text="{x:Bind AgeText}"
                                        Foreground="White"
                                        FontSize="10"
                                        FontWeight="SemiBold" />
                                </Border>
                                <TextBlock
                                    Text="{x:Bind ModifiedText}"
                                    Opacity="0.65"
                                    FontSize="12"
                                    VerticalAlignment="Center" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <GridView
                x:Name="FileIcons"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsItemClickEnabled="False"
                CanDragItems="True"
                AllowDrop="True"
                DoubleTapped="OnListDoubleTapped"
                SelectionChanged="OnSelectionChanged"
                ContainerContentChanging="OnFileContainerContentChanging"
                KeyDown="OnListKeyDown"
                RightTapped="OnListRightTapped"
                DragItemsStarting="OnDragItemsStarting"
                DragItemsCompleted="OnDragItemsCompleted"
                DragOver="OnListDragOver"
                Drop="OnListDrop"
                ItemsSource="{Binding VisibleItems, Mode=OneWay}"
                SelectedItem="{Binding SelectedItem, Mode=OneWay}"
                SelectionMode="Extended"
                Visibility="{Binding IsIconsView, Converter={StaticResource BoolToVisibilityConverter}}">
                <GridView.ItemContainerTransitions>
                    <TransitionCollection />
                </GridView.ItemContainerTransitions>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="4" />
                        <Setter Property="Width" Value="96" />
                        <Setter Property="Height" Value="100" />
                        <Setter Property="Padding" Value="4" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileListItemViewModel">
                        <Grid
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind TypeText}"
                            ToolTipService.ToolTip="{x:Bind ColorTooltip, Mode=OneWay, Converter={StaticResource NullIfEmptyStringConverter}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Grid.Column="0"
                                Width="3"
                                CornerRadius="1.5"
                                VerticalAlignment="Stretch"
                                Margin="0,4"
                                Background="{x:Bind ColorKey, Mode=OneWay, Converter={StaticResource ColorKeyToBrushConverter}}" />
                            <StackPanel
                                Grid.Column="1"
                                Spacing="6"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Padding="4,0,0,0">
                                <Grid Width="48" Height="48" HorizontalAlignment="Center">
                                    <Border
                                        Width="48"
                                        Height="48"
                                        CornerRadius="8"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                        <Grid Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <FontIcon
                                                FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                Glyph="{x:Bind IconGlyph}"
                                                FontSize="28"
                                                Foreground="{x:Bind GlyphBrush}"
                                                Visibility="{x:Bind HasBitmapIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                            <Image
                                                Source="{x:Bind IconImage, Mode=OneWay}"
                                                Width="32"
                                                Height="32"
                                                Stretch="Uniform"
                                                Visibility="{x:Bind HasBitmapIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                        </Grid>
                                    </Border>
                                    <Ellipse
                                        Width="9"
                                        Height="9"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,-2,-2,0"
                                        Fill="{x:Bind ColorKey, Mode=OneWay, Converter={StaticResource ColorKeyToBrushConverter}}"
                                        Visibility="{x:Bind HasColor, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <FontIcon
                                        Glyph="&#xE840;"
                                        FontSize="10"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        Margin="-2,-2,0,0"
                                        Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                        Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                        ToolTipService.ToolTip="已置顶" />
                                </Grid>
                                <TextBlock
                                    Text="{x:Bind Name, Mode=OneWay}"
                                    FontSize="11"
                                    TextAlignment="Center"
                                    TextWrapping="WrapWholeWords"
                                    TextTrimming="CharacterEllipsis"
                                    MaxLines="2"
                                    MaxHeight="36" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <GridView
                x:Name="FileCards"
                Background="Transparent"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                IsItemClickEnabled="False"
                CanDragItems="True"
                AllowDrop="True"
                DoubleTapped="OnListDoubleTapped"
                SelectionChanged="OnSelectionChanged"
                ContainerContentChanging="OnFileContainerContentChanging"
                KeyDown="OnListKeyDown"
                RightTapped="OnListRightTapped"
                DragItemsStarting="OnDragItemsStarting"
                DragItemsCompleted="OnDragItemsCompleted"
                DragOver="OnListDragOver"
                Drop="OnListDrop"
                ItemsSource="{Binding VisibleItems, Mode=OneWay}"
                SelectedItem="{Binding SelectedItem, Mode=OneWay}"
                SelectionMode="Extended"
                Visibility="{Binding IsCardsView, Converter={StaticResource BoolToVisibilityConverter}}">
                <GridView.ItemContainerTransitions>
                    <TransitionCollection />
                </GridView.ItemContainerTransitions>
                <GridView.ItemContainerStyle>
                    <Style TargetType="GridViewItem">
                        <Setter Property="Margin" Value="6" />
                        <Setter Property="Width" Value="168" />
                        <Setter Property="Height" Value="118" />
                        <Setter Property="Padding" Value="0" />
                    </Style>
                </GridView.ItemContainerStyle>
                <GridView.ItemTemplate>
                    <DataTemplate x:DataType="vm:FileListItemViewModel">
                        <Border
                            Padding="0"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                            AutomationProperties.HelpText="{x:Bind TypeText}"
                            ToolTipService.ToolTip="{x:Bind ColorTooltip, Mode=OneWay, Converter={StaticResource NullIfEmptyStringConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="0"
                                    Width="4"
                                    CornerRadius="8,0,0,8"
                                    Background="{x:Bind ColorKey, Mode=OneWay, Converter={StaticResource ColorKeyToBrushConverter}}" />
                                <Grid Grid.Column="1" Padding="10" RowSpacing="6">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            Width="36"
                                            Height="36"
                                            CornerRadius="6"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                            <Grid Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <FontIcon
                                                    FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                                    Glyph="{x:Bind IconGlyph}"
                                                    FontSize="18"
                                                    Foreground="{x:Bind GlyphBrush}"
                                                    Visibility="{x:Bind HasBitmapIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=Invert}" />
                                                <Image
                                                    Source="{x:Bind IconImage, Mode=OneWay}"
                                                    Width="20"
                                                    Height="20"
                                                    Stretch="Uniform"
                                                    Visibility="{x:Bind HasBitmapIcon, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <FontIcon
                                                    Glyph="&#xE840;"
                                                    FontSize="10"
                                                    VerticalAlignment="Center"
                                                    Foreground="{ThemeResource SystemFillColorAttentionBrush}"
                                                    Visibility="{x:Bind IsPinned, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    ToolTipService.ToolTip="已置顶" />
                                                <TextBlock
                                                    Text="{x:Bind Name, Mode=OneWay}"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis"
                                                    MaxLines="2"
                                                    TextWrapping="WrapWholeWords" />
                                            </StackPanel>
                                            <TextBlock
                                                Text="{x:Bind TypeText}"
                                                FontSize="10"
                                                Opacity="0.55"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Ellipse
                                            Grid.Column="2"
                                            Width="9"
                                            Height="9"
                                            VerticalAlignment="Top"
                                            Margin="4,2,0,0"
                                            Fill="{x:Bind ColorKey, Mode=OneWay, Converter={StaticResource ColorKeyToBrushConverter}}"
                                            Visibility="{x:Bind HasColor, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    </Grid>
                                    <TextBlock
                                        Grid.Row="1"
                                        Text="{x:Bind NoteDisplay, Mode=OneWay}"
                                        FontSize="10"
                                        Opacity="0.55"
                                        TextTrimming="CharacterEllipsis"
                                        MaxLines="2"
                                        Visibility="{x:Bind HasNote, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                                    <Grid Grid.Row="2">
                                        <TextBlock
                                            Text="{x:Bind SizeText, Mode=OneWay}"
                                            FontSize="10"
                                            Opacity="0.6"
                                            VerticalAlignment="Center" />
                                        <Border
                                            HorizontalAlignment="Right"
                                            Background="{x:Bind AgeBrush}"
                                            CornerRadius="3"
                                            Padding="5,1"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind AgeText}"
                                                Foreground="White"
                                                FontSize="9"
                                                FontWeight="SemiBold" />
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </GridView.ItemTemplate>
            </GridView>

            <ProgressRing
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsActive="{Binding IsLoading, Mode=OneWay}"
                Width="28"
                Height="28" />

            <!-- 选中后悬浮快捷操作条：跟手贴在点击右上方，避开名称与上一条 -->
            <Canvas x:Name="QuickActionsLayer" IsHitTestVisible="True">
                <Border
                    x:Name="QuickActionsBar"
                    Visibility="Collapsed"
                    Padding="3,1"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    Background="{ThemeResource SolidBackgroundFillColorSecondaryBrush}"
                    MaxHeight="34">
                    <StackPanel Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
                        <Button
                            Style="{StaticResource AppToolButtonStyle}"
                            MinWidth="26"
                            MinHeight="26"
                            Width="26"
                            Height="26"
                            Padding="3,2"
                            IsTabStop="False"
                            AllowFocusOnInteraction="False"
                            Click="OnQuickCutClick"
                            ToolTipService.ToolTip="剪切 (Ctrl+X)">
                            <FontIcon Glyph="&#xE8C6;" FontSize="13" Foreground="#CA5010" />
                        </Button>
                        <Button
                            Style="{StaticResource AppToolButtonStyle}"
                            MinWidth="26"
                            MinHeight="26"
                            Width="26"
                            Height="26"
                            Padding="3,2"
                            IsTabStop="False"
                            AllowFocusOnInteraction="False"
                            Click="OnQuickCopyClick"
                            ToolTipService.ToolTip="复制 (Ctrl+C)">
                            <FontIcon Glyph="&#xE8C8;" FontSize="13" Foreground="{StaticResource AppAccentBrush}" />
                        </Button>
                        <Button
                            Style="{StaticResource AppToolButtonStyle}"
                            MinWidth="26"
                            MinHeight="26"
                            Width="26"
                            Height="26"
                            Padding="3,2"
                            IsTabStop="False"
                            AllowFocusOnInteraction="False"
                            Click="OnQuickCopyPathClick"
                            ToolTipService.ToolTip="复制路径 (Ctrl+Shift+C)">
                            <FontIcon Glyph="&#xE71B;" FontSize="13" Foreground="#038387" />
                        </Button>
                        <Button
                            Style="{StaticResource AppToolButtonStyle}"
                            MinWidth="26"
                            MinHeight="26"
                            Width="26"
                            Height="26"
                            Padding="3,2"
                            IsTabStop="False"
                            AllowFocusOnInteraction="False"
                            Click="OnQuickRenameClick"
                            ToolTipService.ToolTip="重命名 (F2)">
                            <FontIcon Glyph="&#xE70F;" FontSize="13" Foreground="#8764B8" />
                        </Button>
                        <Button
                            Style="{StaticResource AppToolButtonStyle}"
                            MinWidth="26"
                            MinHeight="26"
                            Width="26"
                            Height="26"
                            Padding="3,2"
                            IsTabStop="False"
                            AllowFocusOnInteraction="False"
                            Click="OnQuickDeleteClick"
                            ToolTipService.ToolTip="删除 (Delete)">
                            <FontIcon Glyph="&#xE74D;" FontSize="13" Foreground="#C42B1C" />
                        </Button>
                        <Button
                            x:Name="QuickPinButton"
                            Style="{StaticResource AppToolButtonStyle}"
                            MinWidth="26"
                            MinHeight="26"
                            Width="26"
                            Height="26"
                            Padding="3,2"
                            IsTabStop="False"
                            AllowFocusOnInteraction="False"
                            Click="OnQuickPinClick"
                            ToolTipService.ToolTip="置顶">
                            <FontIcon x:Name="QuickPinIcon" Glyph="&#xE840;" FontSize="13" Foreground="#CA5010" />
                        </Button>
                        <Button
                            Style="{StaticResource AppToolButtonStyle}"
                            MinWidth="26"
                            MinHeight="26"
                            Width="26"
                            Height="26"
                            Padding="3,2"
                            IsTabStop="False"
                            AllowFocusOnInteraction="False"
                            Click="OnQuickPropertiesClick"
                            ToolTipService.ToolTip="属性 (Alt+Enter)">
                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="#005A9E" />
                        </Button>
                    </StackPanel>
                </Border>
            </Canvas>
            </Grid>

            <Border
                x:Name="PreviewPane"
                Grid.Column="1"
                Width="280"
                Margin="4,0,8,8"
                Padding="10"
                CornerRadius="8"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                Visibility="{Binding IsPreviewPaneVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        x:Name="PreviewTitle"
                        FontSize="12"
                        FontWeight="SemiBold"
                        TextTrimming="CharacterEllipsis"
                        Margin="0,0,0,8"
                        Opacity="0.85"
                        Text="预览" />
                    <ScrollViewer
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <ContentControl
                            x:Name="PreviewHost"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Top" />
                    </ScrollViewer>
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
