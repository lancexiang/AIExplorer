<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="AIExplorer_App.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="using:AIExplorer_App.Views"
    HorizontalAlignment="Stretch"
    VerticalAlignment="Stretch"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 文件夹卡片：图标 + 名称，圆角底对齐 Allen -->
        <DataTemplate x:Key="FolderCardTemplate" x:DataType="views:HomeItem">
            <Border
                Width="168"
                Padding="12,10"
                CornerRadius="8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                ToolTipService.ToolTip="{x:Bind Path}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Glyph="{x:Bind Glyph}"
                        Foreground="{x:Bind Brush}"
                        FontSize="26" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind Name}"
                        FontSize="13"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 驱动器卡片：图标 + 名称 + 容量条 -->
        <DataTemplate x:Key="DriveCardTemplate" x:DataType="views:HomeItem">
            <Border
                Width="260"
                Padding="12,10"
                CornerRadius="8"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                ToolTipService.ToolTip="{x:Bind CapacityText}">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Glyph="{x:Bind Glyph}"
                        Foreground="{x:Bind Brush}"
                        FontSize="28" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                        <ProgressBar
                            Value="{x:Bind UsagePercent}"
                            Maximum="100"
                            MinHeight="6"
                            Foreground="{x:Bind UsageBrush}" />
                        <TextBlock Text="{x:Bind CapacityText}" FontSize="11" Opacity="0.6" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 最近文件：小图标 + 名称 -->
        <DataTemplate x:Key="RecentFileTemplate" x:DataType="views:HomeItem">
            <Border
                Width="220"
                Padding="10,8"
                CornerRadius="6"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                ToolTipService.ToolTip="{x:Bind Path}">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Grid.Column="0"
                        Glyph="{x:Bind Glyph}"
                        Foreground="{x:Bind Brush}"
                        FontSize="16" />
                    <TextBlock
                        Grid.Column="1"
                        Text="{x:Bind Name}"
                        FontSize="12"
                        VerticalAlignment="Center"
                        TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </DataTemplate>

        <Style x:Key="HomeSectionHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.85" />
        </Style>

        <Style x:Key="HomeGridViewStyle" TargetType="GridView">
            <Setter Property="SelectionMode" Value="None" />
            <Setter Property="IsItemClickEnabled" Value="True" />
            <Setter Property="Margin" Value="0,0,0,22" />
        </Style>

        <Style TargetType="GridViewItem">
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,18,28,0">
        <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FavoriteHeader" Style="{StaticResource HomeSectionHeaderStyle}" Margin="4,0,12,0" />
                <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.55" />
            </Grid>
            <GridView
                x:Name="FavoriteGrid"
                Style="{StaticResource HomeGridViewStyle}"
                ItemTemplate="{StaticResource FolderCardTemplate}"
                ItemClick="OnFolderItemClick" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="SystemHeader" Style="{StaticResource HomeSectionHeaderStyle}" Margin="4,0,12,0" />
                <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.55" />
            </Grid>
            <GridView
                x:Name="SystemGrid"
                Style="{StaticResource HomeGridViewStyle}"
                ItemTemplate="{StaticResource FolderCardTemplate}"
                ItemClick="OnFolderItemClick" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="DriveHeader" Style="{StaticResource HomeSectionHeaderStyle}" Margin="4,0,12,0" />
                <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.55" />
            </Grid>
            <GridView
                x:Name="DriveGrid"
                Style="{StaticResource HomeGridViewStyle}"
                ItemTemplate="{StaticResource DriveCardTemplate}"
                ItemClick="OnFolderItemClick" />

            <Grid x:Name="NetworkSectionHeader" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="NetworkDriveHeader" Style="{StaticResource HomeSectionHeaderStyle}" Margin="4,0,12,0" />
                <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.55" />
            </Grid>
            <GridView
                x:Name="NetworkDriveGrid"
                Style="{StaticResource HomeGridViewStyle}"
                ItemTemplate="{StaticResource DriveCardTemplate}"
                ItemClick="OnFolderItemClick" />

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="RecentHeader" Style="{StaticResource HomeSectionHeaderStyle}" Margin="4,0,12,0" />
                <Border Grid.Column="1" Height="1" VerticalAlignment="Center" Background="{ThemeResource DividerStrokeColorDefaultBrush}" Opacity="0.55" />
            </Grid>
            <GridView
                x:Name="RecentGrid"
                Style="{StaticResource HomeGridViewStyle}"
                ItemTemplate="{StaticResource RecentFileTemplate}"
                ItemClick="OnRecentItemClick" />

            <Border Height="16" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
